# Skopiuj jako .env.development.local i wpisz dane projektu LSO-dev
# (Supabase → LSO-dev → Project Settings → API).
# `expo start` (mobile + web) użyje tych wartości zamiast .env (produkcji).
# `expo export` i buildy produkcyjne dalej używają .env.
EXPO_PUBLIC_SUPABASE_URL=https://<ref-projektu-dev>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key z LSO-dev>
